# スライド作成プロンプトメーカー（購入者専用ページ /member/slide-prompt-generator）
# 購入者に案内するログインパスワード
SLIDE_PROMPT_PASSWORD=
# 認証成功時に発行するcookieの値（推測されにくいランダムな文字列を設定）
SLIDE_PROMPT_COOKIE_VALUE=

# 姿勢別 自主トレ指導資料セット（Stripe Price ID）
STRIPE_PRICE_ID_POSTURE_SELF_TRAINING_SET=

# Plus LP（締切日時と表示ラベルは同時に更新。実績値は確定後のみ設定）
NEXT_PUBLIC_PLUS_PROMO_DEADLINE_LABEL=
NEXT_PUBLIC_PLUS_PROMO_DEADLINE_ISO=
NEXT_PUBLIC_PROOF_TOTAL_DL=
NEXT_PUBLIC_PROOF_LINE_FRIENDS=
