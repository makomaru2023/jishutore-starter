# スライド作成プロンプトメーカー（購入者専用ページ /member/slide-prompt-generator）
# 購入者に案内するログインパスワード
SLIDE_PROMPT_PASSWORD=
# 認証成功時に発行するcookieの値（推測されにくいランダムな文字列を設定）
SLIDE_PROMPT_COOKIE_VALUE=

# 姿勢別 自主トレ指導資料セット（Stripe Price ID）
STRIPE_PRICE_ID_POSTURE_SELF_TRAINING_SET=

# Plus LP（締切日時と表示ラベルは同時に更新。実績値は確定後のみ設定）
NEXT_PUBLIC_PLUS_PROMO_DEADLINE_LABEL=
NEXT_PUBLIC_PLUS_PROMO_DEADLINE_ISO=
NEXT_PUBLIC_PROOF_TOTAL_DL=
NEXT_PUBLIC_PROOF_LINE_FRIENDS=

# Plus 月払い（新規登録者に適用する現在価格。値上げ時はここを新しい価格IDに差し替える）
STRIPE_PRICE_ID_PLUS_CURRENT=
# Plus 年払い（未設定なら年払いは表示も購入もされない。必ず既存のPlus商品配下に作った価格IDを設定する）
STRIPE_PRICE_ID_PLUS_CURRENT_YEARLY=
# 年払いの公開開始日時（既定 2026-08-01T00:00:00+09:00。これを過ぎると自動表示）
NEXT_PUBLIC_PLUS_YEARLY_START_ISO=
# 表示タイミングの手動オーバーライド。通常は未設定。
#   true=開始日を待たず即表示（確認用） / false=開始日を過ぎても出さない（緊急停止）
NEXT_PUBLIC_PLUS_YEARLY_ACTIVE=
# 年払いの表示価格（既定 9800）
NEXT_PUBLIC_PLUS_YEARLY_PRICE_YEN=
